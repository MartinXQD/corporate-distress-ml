      {
        "type": "paragraph",
        "text": "\u5b8c\u6574\u4e09\u5e74\u521d\u7b5b22\u4e2atrial\uff0c\u53bb\u6389\u529f\u80fd\u91cd\u590d\u540e21\u4e2a\u6709\u6548\u4e0d\u540c\u914d\u65b9\uff1b\u5b8c\u6574\u5c40\u90e8\u4fee\u6b633\u4e2a\uff0c\u5355\u5e74\u6865\u63a519\u4e2a\uff0c\u8bb0\u8d26\u62df\u5408\u8c03\u7528267\u6b21\u3002fold\u3001seed\u548cTabM head\u90fd\u6ca1\u6709\u5f53\u4f5c\u65b0\u65b9\u6cd5\u3002"
      },
      {
        "type": "paragraph",
        "text": "\u771f\u5b9e\u76ee\u6807\u8fdc\u672a\u8fbe\u5230\uff0c\u4e0d\u80fd\u79f0\u201c\u5145\u5206\u8c03\u4f18\u201d\u3002\u603bUTC\u7a97\u53e3\u51fa\u73b0\u957f\u95f4\u9694\uff0c\u4f46\u73b0\u6709\u8bc1\u636e\u6ca1\u6709\u786e\u8ba4\u539f\u56e0\uff1b\u5355\u8c03\u62df\u5408\u8ba1\u65f6\u4e0e\u603bwall-clock\u5206\u5f00\u62a5\u544a\u3002\u6700\u540e\u62df\u5408\u542f\u52a8\u5728\u539f\u622a\u6b62\u524d\uff0c\u622a\u6b62\u540e\u6ca1\u6709\u8865\u8dd1\u3002\u7ed3\u9879\u6750\u6599\u662f\u5728\u7a97\u53e3\u7ed3\u675f\u540e\u6574\u7406\u7684\u3002"
      },
      {
        "type": "paragraph",
        "text": "\u672c\u8f6e\u6ca1\u6709\u5efa\u7acb\u8d85\u8fc7\u65e7\u5f3a\u914d\u65b9\u7684\u5386\u53f2\u8bc1\u636e\uff0c\u4e5f\u6ca1\u6709\u5b8c\u6210\u4e94seed\u7a33\u5b9a\u6027\u548c\u516c\u53f8\u6cdb\u5316\u3002\u4e0d\u80fd\u7528\u67b6\u6784\u540d\u79f0\u3001\u53c2\u6570\u91cf\u6216\u5355\u5e74\u9ad8\u5206\u6765\u66ff\u4ee3\u8fd9\u4e9b\u8bc1\u636e\u3002\u66f4\u591a\u8ba1\u7b97\u662f\u5426\u503c\u5f97\uff0c\u987b\u5728\u4e0b\u4e00\u6b21\u83b7\u6388\u6743\u7684\u9884\u7b97\u5185\u5b8c\u6210\u771f\u5b9e\u5171\u540c\u53e3\u5f84\u6bd4\u8f83\u540e\u518d\u5224\u65ad\u3002"
      }
    ]
  },
  {
    "title": "5. \u7f3a\u5c11\u54ea\u4e00\u6b65\u3001\u5982\u4f55\u8bda\u5b9e\u8868\u8fbe",
    "subtitle": null,
    "blocks": [
      {
        "type": "paragraph",
        "text": "\u672a\u5b8c\u6210\uff1a\u4e94\u5e74\u00d7\u4e09seed\u5165\u56f4\u7a33\u5b9a\u6027\uff1b2014\u4e00\u6b21\u786e\u8ba4\uff1b\u622a\u81f32014\u7684\u4e94seed\u6700\u7ec8\u62df\u5408\uff1b2015-2018\u51bb\u7ed3\u6279\u91cf\u8bc4\u5206\uff1b\u516c\u53f8\u7559\u7ec4\u538b\u529b\u3001\u914d\u5bf9bootstrap\u548c\u6700\u7ec8\u6a21\u578b\u5de5\u4ef6\u3002\u5b8c\u6574PLE/TabM\u3001CatBoost/XGBoost\u7b49\u641c\u7d22\u76ee\u6807\u4e5f\u6709\u7f3a\u53e3\u3002"
      },
      {
        "type": "paragraph",
        "text": "\u56e0\u6b64GitHub\u672a\u63a8\u9001\uff1a\u5b9e\u9a8c\u548c\u6838\u9a8c\u95e8\u69db\u5c1a\u672a\u6ee1\u8db3\uff0c\u968f\u540e\u4ecd\u9700\u73b0\u573a\u6838\u9a8cGitHub\u8eab\u4efd\u4e0e\u516c\u5f00\u6587\u4ef6\u9690\u79c1\u3002\u6ca1\u6709\u4e0a\u4f20\u539f\u59cb\u6570\u636e\u3001\u516c\u53f8\u7ea7\u9884\u6d4b\u6216\u79c1\u6709\u6e90\u6587\u4ef6\u3002"
      },
      {
        "type": "paragraph",
        "text": "\u539f\u6587\u4ef6\u54c8\u5e0c\u590d\u6838\uff1a\u5168\u90e81345\u4e2a\u539f\u6587\u4ef6\u4e0e\u521d\u59cb\u6e05\u5355\u4e00\u81f4\u3002 \u5df2\u505c\u6b62\u672c\u6b21\u8bad\u7ec3\u4e0e\u4e34\u65f6\u8fdb\u7a0b\u3002"
      },
      {
        "type": "paragraph",
        "text": "\u9762\u8bd5\u53ef\u8bf4\uff1a\u8fc1\u79fb\u5e76\u6838\u5bf9\u65e7\u7f51\u7edc\uff0c\u6267\u884c\u4e86\u771f\u5b9e\u7684\u5f00\u53d1\u671f\u914d\u7f6e\u4e0e\u91c7\u6837\u63a7\u5236\uff0c\u53d1\u73b0\u5e76\u7ea0\u6b63\u8fc1\u79fb\u9519\u8bef\uff1b\u5c1a\u672a\u5b8c\u6210\u6700\u7ec8\u6027\u80fd\u9a8c\u8bc1\u3002\u4e0d\u80fd\u8bf4\u5df2\u63d0\u9ad8\u5386\u53f2\u6210\u7ee9\u3001\u5b8c\u6210\u73b0\u4ee3embedding\u8c03\u4f18\u6216\u83b7\u5f97\u4e94seed\u516c\u53f8\u6cdb\u5316\u7ed3\u8bba\u3002\u7f72\u540d\u4e3aQidian (Martin) Xing\uff0c\u539f\u56e2\u961f\u6309\u7236\u76ee\u5f55\u51c6\u786e\u81f4\u8c22\uff1b\u4ee3\u7801\u4e0e\u5206\u6790\u7531Codex\u8f85\u52a9\u6267\u884c\u3002"
      },
      {
        "type": "paragraph",
        "text": "\u539f8\u5c0f\u65f6\u9884\u7b97\u4e0d\u53ef\u91cd\u7f6e\u3002\u7eed\u8dd1\u9700\u8981\u65b0\u7684\u660e\u786e\u8ba1\u7b97\u6388\u6743\u53ca\u5355\u72ec\u767b\u8bb0\u7a97\u53e3\uff0c\u540c\u65f6\u4fdd\u7559\u6b64\u6b21\u7ed3\u679c\u4e0e\u5931\u8d25\u8bb0\u5f55\u3002NEXT_ACTIONS.md\u5217\u51fa\u7f3a\u9879\uff1b\u5f53\u524dresume\u547d\u4ee4\u53ea\u4f5c\u6d41\u7a0b\u8bf4\u660e\uff0c\u4e0d\u80fd\u5728\u8fc7\u671f\u7a97\u53e3\u7ee7\u7eed\u8bad\u7ec3\u3002"
      }
    ]
  }
]